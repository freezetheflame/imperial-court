# Imperial Court backend secrets template — copy to .env and fill in
# LLM provider — OpenAI-compatible (DeepSeek works out of the box)
IMPERIAL_LLM_API_KEY=sk-your-key-here
IMPERIAL_LLM_BASE_URL=https://api.deepseek.com
IMPERIAL_LLM_MODEL=deepseek-v4-flash

# 制度换装：制度 id（institutions/ 下的文件名去 .yaml）或 YAML 文件路径
# 可选值：sanguan-jiuqing（默认，三公九卿）/ sansheng-liubu（三省六部）
#IMPERIAL_INSTITUTION=sansheng-liubu
